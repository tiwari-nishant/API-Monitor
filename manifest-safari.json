{
  "manifest_version": 3,
  "name": "OpenBMC GUI Monitor",
  "version": "1.0.0",
  "description": "Monitor and capture OpenBMC Redfish API calls with export functionality",

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-96.png"
  },

  "permissions": [
    "storage",
    "tabs",
    "webRequest"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background/service-worker-safari.js"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Open OpenBMC Monitor"
  }
}
